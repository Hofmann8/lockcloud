# ============================================
# LockCloud Frontend Environment Configuration
# ============================================
# 默认建议：
# - 开发环境放在 .env.development
# - 生产环境放在 .env.production
# - .env.local 只放临时本机覆盖项

# API Configuration
# 开发环境:
# NEXT_PUBLIC_API_URL=http://localhost:5000

# 生产环境:
# NEXT_PUBLIC_API_URL=https://cloud.funk-and.love
