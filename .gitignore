# ==========================================
# Python Backend
# ==========================================
**/__pycache__/
*.py[cod]
*$py.class
backend/*.so
backend/.Python
backend/env/
backend/venv/
backend/ENV/
backend/.venv
backend/instance/
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/
backend/dist/
backend/build/
backend/*.egg-info/
backend/.env
# logs/ 是 Python 模块（FileLog ORM），只忽略里面的运行日志
backend/logs/*.log*
backend/instance/*.db
backend/instance/*.sqlite
backend/instance/*.sqlite3

# InsightFace / 其它 ML 模型权重(几百 MB 不进库)
# Docker 镜像构建时会 COPY 这一份进容器,本地保留即可
backend/models/

# FC 镜像 build context 里的模型副本(prepare.ps1 复制进来),同样 ~326MB 不进库
backend/fc/face/insightface/

# 媒体 FC 的节拍模型（export_beat_model.py 导出，83MB）
backend/fc/media/beat_this.onnx

