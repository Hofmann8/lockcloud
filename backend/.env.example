# ============================================
# LockCloud 后端环境变量
# ============================================
# 复制成 .env 再填。后端命令都在 conda 的 lockcloud 环境里跑: conda activate lockcloud

# 运行环境: development / production。读 APP_ENV，没有再读 FLASK_ENV，两个都没有就是 development。
# production 关掉 /docs 和报错里的异常原文，线上必须写 production
APP_ENV=development
# 生成密钥: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 也用来签 HLS 播放地址里的短期 token
SECRET_KEY=your-secret-key-here-change-this

# 数据库: SQLite + sqlite-vec。相对路径会放进 backend/instance/
DATABASE_URL=sqlite:///lockcloud.db

# 登录令牌: 密钥和 LockAuth 用同一个，LockAuth 签的令牌这边才认
JWT_SECRET_KEY=your-jwt-secret-key-here-change-this
# 有效期，秒（7 天）
JWT_ACCESS_TOKEN_EXPIRES=604800

# 统一登录 LockAuth
SSO_AUTH_API_URL=https://auth.funk-and.love
SSO_AUTH_FRONTEND_URL=https://auth.funk-and.love
# 头像归 LockAuth: 调它的 /api/auth/service/avatars 用的密钥，由 LockAuth 发（见 lockauth/REQUESTS.md）
# 不配时头像显示名字首字，其他功能不受影响
LOCKAUTH_SERVICE_KEY=

# 本地免密登录（前端 /auth/dev-login）。只在本地开，线上必须是 false
DEV_LOGIN_ENABLED=false

# 对象存储: 阿里云 OSS，杭州，lock-cloud 私有桶放文件和数据库备份
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_REGION=cn-hangzhou
OSS_BUCKET=lock-cloud
# 给浏览器 / App 的签名地址用外网 endpoint
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# 服务器自己读写用内网（不收流量费）。只有杭州的机器连得上，本地开发留空
# 线上填: https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_INTERNAL_ENDPOINT=

# 媒体 FC 回调 /api/files/internal/media-result 时带的令牌，FC 环境变量里填同一个值
# 后端调 FC 的 /jobs/zip、/jobs/process 也用它鉴权（X-Media-Token）
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
MEDIA_CALLBACK_TOKEN=your-media-callback-token
# 媒体 FC 的 HTTP 触发器地址（打包下载、管理页重跑），不带路径。不配时这两个功能不可用
MEDIA_FC_ENDPOINT=https://lockcloud-media-xxxx.cn-hangzhou.fcapp.run

# 图文向量: DashScope 的多模态 embedding。不配时语义搜索返回 503，新图片不会自动入库
DASHSCOPE_API_KEY=

# 人脸识别 FC（InsightFace），scripts/face_worker.py 和新图片的自动入库会调它。不配时不识别人脸
FACE_FC_ENDPOINT=https://lockcloud-face-xxxx.cn-hangzhou.fcapp.run
# FC 触发器开了 Bearer 认证才填
FACE_FC_TOKEN=

# LockAI 分析（services/lockai.py）：用上面的 DASHSCOPE_API_KEY。百炼控制台给了专属地址就填，不填用公共地址
DASHSCOPE_BASE_URL=
LOCKAI_MODEL=qwen3.8-omni-flash
LOCKAI_MONTHLY_QUOTA=3          # 每人每月发起几次，管理员不限
LOCKAI_CONCURRENCY=3            # 同时分析几个
# All-In-One 函数（backend/fc/allin1）的 HTTP 触发器地址：LockAI 分析时顺带测小节头，校正八拍放错半个小节的地方。不配就不校正
LOCKAI_ALLIN1_URL=

# 允许访问的前端地址，逗号分隔
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://cloud.funk-and.love

# 本地开发可选: 设 1 不起每日定时任务（清理上传、清回收站、备份、人脸聚类）。
# 本地 .env 填的是线上的 OSS 密钥时建议设上，免得本地进程去动线上的桶
# LOCKCLOUD_SCHEDULER_DISABLED=1
